# UWP packaging: signed packages and signing material are produced locally and
# must never be committed (the .pfx is a private key; the appx embeds it).
/Launcher/uwp-appx/*.appx
/Launcher/uwp-appx/*.pfx
/Launcher/uwp-appx/*.cer
/Launcher/uwp-appx/deploy-result.txt
# Runtime binaries staged into the appx layout by the packaging step.
/Launcher/uwp-appx/package/*.dll
/Launcher/uwp-appx/package/WiiCompiled.exe
/Launcher/uwp-appx/package/RetroRewind.exe
/Launcher/uwp-appx/package/initial_pipeline_cache.db
/Launcher/uwp-appx/package/Config.toml

